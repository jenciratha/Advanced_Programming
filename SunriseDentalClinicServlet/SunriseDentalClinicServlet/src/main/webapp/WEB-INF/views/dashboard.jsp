<c:set var="pageTitle" value="Dashboard"/><%@ include file="includes/header.jspf" %><h1>Dashboard</h1><section class="metrics"><c:forEach var="m" items="${metrics}"><article class="card"><span>${m.key}</span><strong>${m.value}</strong></article></c:forEach></section><h2>Today's schedule</h2><table><tr><th>Number</th><th>Time</th><th>Patient</th><th>Dentist</th><th>Status</th></tr><c:forEach var="a" items="${appointments}"><tr><td><a href="${pageContext.request.contextPath}/appointments/view?no=${a.appointmentNumber}">${a.appointmentNumber}</a></td><td>${a.appointmentTime}</td><td>${a.patientName}</td><td>${a.dentistName}</td><td>${a.status}</td></tr></c:forEach></table><%@ include file="includes/footer.jspf" %>