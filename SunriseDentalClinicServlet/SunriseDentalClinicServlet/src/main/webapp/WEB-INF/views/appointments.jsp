<c:set var="pageTitle" value="Appointments"/><%@ include file="includes/header.jspf" %><h1>Appointments</h1><form class="filters"><input name="q" value="${param.q}" placeholder="Number or patient"><input type="date" name="date" value="${param.date}"><select name="status"><option value="">All statuses</option><option>BOOKED</option><option>CONFIRMED</option><option>CHECKED_IN</option><option>COMPLETED</option><option>CANCELLED</option><option>NO_SHOW</option></select><button>Search</button></form><table><tr><th>Number</th><th>Date</th><th>Time</th><th>Patient</th><th>Dentist</th><th>Treatment</th><th>Status</th></tr><c:forEach var="a" items="${appointments}"><tr><td><a href="${pageContext.request.contextPath}/appointments/view?no=${a.appointmentNumber}">${a.appointmentNumber}</a></td><td>${a.appointmentDate}</td><td>${a.appointmentTime}</td><td>${a.patientName}</td><td>${a.dentistName}</td><td>${a.treatmentName}</td><td>${a.status}</td></tr></c:forEach></table><%@ include file="includes/footer.jspf" %>