<c:set var="pageTitle" value="New Appointment"/><%@ include file="includes/header.jspf" %><h1>Register New Appointment</h1><c:if test="${not empty error}"><div class="error">${error}</div></c:if><form class="card grid" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><label>Patient name<input name="patientName" value="${param.patientName}" required><small>${errors.patientName}</small></label><label>Contact number<input name="contact" value="${param.contact}" placeholder="0771234567" required><small>${errors.contact}</small></label><label class="wide">Address<textarea name="address" required>${param.address}</textarea><small>${errors.address}</small></label><label>Email<input type="email" name="email" value="${param.email}"></label><label>Dentist<select name="dentistId" required><c:forEach var="d" items="${dentists}"><option value="${d.id}">${d.fullName} - ${d.specialization}</option></c:forEach></select></label><label>Treatment<select name="treatmentId" required><c:forEach var="t" items="${treatments}"><option value="${t.id}">${t.name} - LKR ${t.price} (${t.durationMinutes} min)</option></c:forEach></select></label><label>Date<input type="date" name="date" required><small>${errors.date}</small></label><label>Time<input type="time" name="time" required><small>${errors.time}</small></label><label class="wide">Notes<textarea name="notes"></textarea></label><button class="primary">Create appointment</button></form><%@ include file="includes/footer.jspf" %>