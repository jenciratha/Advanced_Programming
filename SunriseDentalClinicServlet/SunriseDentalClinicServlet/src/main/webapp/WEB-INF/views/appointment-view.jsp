<c:set var="pageTitle" value="Appointment"/><%@ include file="includes/header.jspf" %><h1>${appointment.appointmentNumber}</h1><section class="card details"><p><b>Patient:</b> ${appointment.patientName}</p><p><b>Dentist:</b> ${appointment.dentistName}</p><p><b>Treatment:</b> ${appointment.treatmentName}</p><p><b>Date/time:</b> ${appointment.appointmentDate} ${appointment.appointmentTime} - ${appointment.endTime}</p><p><b>Status:</b> ${appointment.status}</p><p><b>Notes:</b> ${appointment.notes}</p></section><h2>Workflow</h2><form method="post" action="${pageContext.request.contextPath}/appointments/status"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="no" value="${appointment.appointmentNumber}"><select name="status"><option>CONFIRMED</option><option>CHECKED_IN</option><option>IN_TREATMENT</option><option>COMPLETED</option><option>CANCELLED</option><option>NO_SHOW</option></select><button>Update status</button></form><h2>Billing</h2><c:choose><c:when test="${empty bill}"><form method="post" action="${pageContext.request.contextPath}/billing/issue"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="no" value="${appointment.appointmentNumber}"><label>Discount<input type="number" min="0" step="0.01" name="discount" value="0"></label><button class="primary">Calculate and issue bill</button></form></c:when><c:otherwise><section class="card"><h3>Receipt ${bill.billNumber}</h3><p>Treatment: LKR ${bill.treatmentFee}</p><p>Consultation: LKR ${bill.consultationFee}</p><p>Discount: LKR ${bill.discount}</p><p><b>Total: LKR ${bill.total}</b></p><button onclick="window.print()">Print receipt</button></section></c:otherwise></c:choose><%@ include file="includes/footer.jspf" %>